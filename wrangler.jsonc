{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ce6ed182-997d-4af6-9dd9-aed107346a89","database_name": "web-app-1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9902ecb5d32d4f118a793c41c606a655" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
